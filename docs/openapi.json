{
  "openapi": "3.1.0",
  "info": {
    "title": "교육 과정 신청 API (교육용 예제)",
    "description": "사내 교육 과정 신청·취소를 다루는 **학습용 예제 API**입니다.\n인증·권한이 없고 실제 운영용이 아닙니다.\n규칙(R1~R7, C1~C4)과 상태코드는 교육용으로 합의한 계약입니다.\n서버의 \"요청 시각\"은 기본적으로 실습 기준 시각 2026-11-20T10:00:00+09:00에 고정되어 있습니다.\n",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "이 앱과 같은 출처"
    }
  ],
  "tags": [
    {
      "name": "신청",
      "description": "교육 과정 신청·취소와 내 신청 목록"
    },
    {
      "name": "과정",
      "description": "교육 과정 목록과 잔여석"
    },
    {
      "name": "실습 정보",
      "description": "실습 환경 확인용"
    }
  ],
  "paths": {
    "/api/enrollments": {
      "get": {
        "tags": [
          "신청"
        ],
        "summary": "내 신청 목록 조회",
        "description": "사원번호의 신청을 신청 ID 순으로 돌려준다. 취소됨 신청도 포함한다. 사원번호가 없거나 공백뿐이면 400 MISSING_FIELD. 사원 존재 여부는 확인하지 않는다(없으면 빈 목록).",
        "operationId": "myEnrollments",
        "parameters": [
          {
            "name": "employeeId",
            "in": "query",
            "description": "사원번호",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "E1001"
          }
        ],
        "responses": {
          "200": {
            "description": "내 신청 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MyEnrollmentResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "사원번호 누락",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MISSING_FIELD": {
                    "description": "MISSING_FIELD",
                    "value": {
                      "code": "MISSING_FIELD",
                      "message": "필수 정보를 입력해 주세요."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "신청"
        ],
        "summary": "과정 신청",
        "description": "사원이 과정을 신청한다. R1 필수 입력 → R2 과정 존재 → R3 신청 마감 → R4 중복 금지 → R5 개인 한도(신청됨 3개 미만) → R6 정원 순서로 확인하고, 처음 위반한 규칙 하나만 응답한다(R7).\n거절되면 데이터가 바뀌지 않는다. 성공하면 언제나 새 신청 ID를 만든다(취소 후 재신청 포함).\n요청 시각은 서버 시계 기준이며 초 단위로 비교한다(마감 정각은 접수).",
        "operationId": "enroll",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentRequest"
              },
              "examples": {
                "정상": {
                  "description": "정상",
                  "value": {
                    "employeeId": "E1001",
                    "courseId": "C-101"
                  }
                },
                "R1 공백 사원번호": {
                  "description": "R1 공백 사원번호",
                  "value": {
                    "employeeId": "   ",
                    "courseId": "C-101"
                  }
                },
                "R2 없는 과정": {
                  "description": "R2 없는 과정",
                  "value": {
                    "employeeId": "E1001",
                    "courseId": "C-999"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "신청 완료(신청됨 상태의 새 신청)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentResponse"
                },
                "examples": {
                  "APPLIED": {
                    "description": "APPLIED",
                    "value": {
                      "enrollmentId": 501,
                      "courseId": "C-101",
                      "status": "APPLIED"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "R1 필수 입력 누락, 또는 JSON 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MISSING_FIELD": {
                    "description": "MISSING_FIELD",
                    "value": {
                      "code": "MISSING_FIELD",
                      "message": "필수 정보를 입력해 주세요."
                    }
                  },
                  "INVALID_REQUEST": {
                    "description": "INVALID_REQUEST",
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "요청 형식이 올바르지 않습니다."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "R2 과정 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "COURSE_NOT_FOUND": {
                    "description": "COURSE_NOT_FOUND",
                    "value": {
                      "code": "COURSE_NOT_FOUND",
                      "message": "존재하지 않는 과정입니다."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "R3 마감, R4 중복, R5 개인 한도, R6 정원",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "ENROLLMENT_CLOSED": {
                    "description": "ENROLLMENT_CLOSED",
                    "value": {
                      "code": "ENROLLMENT_CLOSED",
                      "message": "신청 기간이 지났습니다."
                    }
                  },
                  "DUPLICATE_ENROLLMENT": {
                    "description": "DUPLICATE_ENROLLMENT",
                    "value": {
                      "code": "DUPLICATE_ENROLLMENT",
                      "message": "이미 신청한 과정입니다."
                    }
                  },
                  "ENROLLMENT_LIMIT": {
                    "description": "ENROLLMENT_LIMIT",
                    "value": {
                      "code": "ENROLLMENT_LIMIT",
                      "message": "동시에 신청할 수 있는 과정은 최대 3개입니다."
                    }
                  },
                  "COURSE_FULL": {
                    "description": "COURSE_FULL",
                    "value": {
                      "code": "COURSE_FULL",
                      "message": "정원이 마감되었습니다."
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "JSON이 아닌 본문",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "UNSUPPORTED_MEDIA_TYPE": {
                    "description": "UNSUPPORTED_MEDIA_TYPE",
                    "value": {
                      "code": "UNSUPPORTED_MEDIA_TYPE",
                      "message": "요청 본문은 application/json 형식이어야 합니다."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/enrollments/{enrollmentId}/cancel": {
      "post": {
        "tags": [
          "신청"
        ],
        "summary": "신청 취소",
        "description": "신청을 취소한다. C1 신청 존재 → C2 상태(신청됨) → C3 취소 기한 순서로 확인한다(C4).\n취소 기한은 과정 시작 일시 − 24시간이며 그 시각까지 취소할 수 있다.\n성공하면 좌석이 즉시 반환되고 사원의 보유 신청 수도 1 줄어든다. 요청 본문은 없다.",
        "operationId": "cancel",
        "parameters": [
          {
            "name": "enrollmentId",
            "in": "path",
            "description": "신청 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 501
          }
        ],
        "responses": {
          "200": {
            "description": "취소 완료",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResponse"
                },
                "examples": {
                  "CANCELLED": {
                    "description": "CANCELLED",
                    "value": {
                      "enrollmentId": 501,
                      "status": "CANCELLED"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "신청 ID가 숫자가 아님",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "INVALID_REQUEST": {
                    "description": "INVALID_REQUEST",
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "요청 형식이 올바르지 않습니다."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "C1 신청 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "ENROLLMENT_NOT_FOUND": {
                    "description": "ENROLLMENT_NOT_FOUND",
                    "value": {
                      "code": "ENROLLMENT_NOT_FOUND",
                      "message": "신청 내역을 찾을 수 없습니다."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "C2 이미 취소됨, C3 취소 기한 지남",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "ALREADY_CANCELLED": {
                    "description": "ALREADY_CANCELLED",
                    "value": {
                      "code": "ALREADY_CANCELLED",
                      "message": "이미 취소된 신청입니다."
                    }
                  },
                  "CANCEL_CLOSED": {
                    "description": "CANCEL_CLOSED",
                    "value": {
                      "code": "CANCEL_CLOSED",
                      "message": "취소 가능 기간이 지났습니다."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/lab-info": {
      "get": {
        "tags": [
          "실습 정보"
        ],
        "summary": "실습 환경 정보",
        "description": "앱 식별자, 서버가 규칙 판단에 쓰는 요청 시각(시계 모드), 데이터 초기화 방법을 돌려준다.",
        "operationId": "labInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LabInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/courses": {
      "get": {
        "tags": [
          "과정"
        ],
        "summary": "과정 목록 조회",
        "description": "모든 과정의 정원, 신청 인원, 잔여석, 신청 마감·시작·취소 기한을 과정 ID 순으로 돌려준다. 잔여석은 신청됨 상태만 세어 계산한다.",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "과정 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CourseResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnrollmentRequest": {
        "type": "object",
        "description": "신청 요청. 두 값 중 하나라도 없거나 공백뿐이면 400 MISSING_FIELD(R1).",
        "properties": {
          "employeeId": {
            "type": "string",
            "description": "사원번호(교육용 가상 값 E1001~E1030)",
            "example": "E1001"
          },
          "courseId": {
            "type": "string",
            "description": "과정 ID",
            "example": "C-101"
          }
        },
        "required": [
          "courseId",
          "employeeId"
        ]
      },
      "EnrollmentResponse": {
        "type": "object",
        "description": "신청 성공 응답",
        "properties": {
          "enrollmentId": {
            "type": "integer",
            "format": "int64",
            "description": "새로 만든 신청 ID",
            "example": 501
          },
          "courseId": {
            "type": "string",
            "description": "과정 ID",
            "example": "C-101"
          },
          "status": {
            "type": "string",
            "description": "신청 상태",
            "enum": [
              "APPLIED",
              "CANCELLED"
            ],
            "example": "APPLIED"
          }
        },
        "required": [
          "courseId",
          "enrollmentId",
          "status"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "오류 응답. 처음 위반한 규칙 하나만 담는다. 내부 예외 정보는 담지 않는다.",
        "properties": {
          "code": {
            "type": "string",
            "description": "오류 코드",
            "enum": [
              "MISSING_FIELD",
              "COURSE_NOT_FOUND",
              "ENROLLMENT_CLOSED",
              "DUPLICATE_ENROLLMENT",
              "ENROLLMENT_LIMIT",
              "COURSE_FULL",
              "ENROLLMENT_NOT_FOUND",
              "ALREADY_CANCELLED",
              "CANCEL_CLOSED",
              "INVALID_REQUEST",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "UNSUPPORTED_MEDIA_TYPE",
              "INTERNAL_ERROR"
            ],
            "example": "COURSE_FULL"
          },
          "message": {
            "type": "string",
            "description": "화면에 그대로 보여 줄 한국어 메시지",
            "example": "정원이 마감되었습니다."
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "CancelResponse": {
        "type": "object",
        "description": "취소 성공 응답",
        "properties": {
          "enrollmentId": {
            "type": "integer",
            "format": "int64",
            "description": "취소한 신청 ID",
            "example": 501
          },
          "status": {
            "type": "string",
            "description": "신청 상태",
            "enum": [
              "APPLIED",
              "CANCELLED"
            ],
            "example": "CANCELLED"
          }
        },
        "required": [
          "enrollmentId",
          "status"
        ]
      },
      "LabInfoResponse": {
        "type": "object",
        "description": "실습 환경 정보",
        "properties": {
          "appId": {
            "type": "string",
            "example": "course-enrollment-testing"
          },
          "notice": {
            "type": "string",
            "example": "교육용 학습 예제입니다. 인증·권한 기능이 없고 실제 운영용이 아닙니다."
          },
          "clockMode": {
            "type": "string",
            "description": "FIXED: 실습 기준 시각에 멈춘 시계, SYSTEM: 실제 현재 시각",
            "example": "FIXED"
          },
          "labNow": {
            "type": "string",
            "format": "date-time",
            "description": "서버가 규칙 판단에 쓰는 현재 요청 시각(초 단위)",
            "example": "2026-11-20T10:00:00+09:00"
          },
          "timeZone": {
            "type": "string",
            "example": "Asia/Seoul"
          },
          "resetMethod": {
            "type": "string",
            "example": "서버를 다시 시작하면 메모리 DB가 초기화되어 기본 과정 4개, 신청 0건 상태로 돌아갑니다."
          }
        },
        "required": [
          "appId",
          "clockMode",
          "labNow",
          "notice",
          "resetMethod",
          "timeZone"
        ]
      },
      "MyEnrollmentResponse": {
        "type": "object",
        "description": "내 신청 목록의 한 줄(취소됨 포함)",
        "properties": {
          "enrollmentId": {
            "type": "integer",
            "format": "int64",
            "example": 501
          },
          "courseId": {
            "type": "string",
            "example": "C-101"
          },
          "courseTitle": {
            "type": "string",
            "example": "테스트 설계 기초"
          },
          "status": {
            "type": "string",
            "enum": [
              "APPLIED",
              "CANCELLED"
            ],
            "example": "APPLIED"
          }
        },
        "required": [
          "courseId",
          "courseTitle",
          "enrollmentId",
          "status"
        ]
      },
      "CourseResponse": {
        "type": "object",
        "description": "과정과 현재 잔여석. 시각은 +09:00(Asia/Seoul) 오프셋으로 표기한다.",
        "properties": {
          "courseId": {
            "type": "string",
            "example": "C-101"
          },
          "title": {
            "type": "string",
            "example": "테스트 설계 기초"
          },
          "capacity": {
            "type": "integer",
            "format": "int32",
            "description": "정원",
            "example": 20
          },
          "appliedCount": {
            "type": "integer",
            "format": "int64",
            "description": "신청 인원(신청됨 상태만)",
            "example": 0
          },
          "remainingSeats": {
            "type": "integer",
            "format": "int64",
            "description": "잔여석 = 정원 − 신청 인원",
            "example": 20
          },
          "enrollmentDeadline": {
            "type": "string",
            "format": "date-time",
            "description": "신청 마감 일시(이 시각까지 접수)",
            "example": "2026-12-01T18:00:00+09:00"
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "description": "과정 시작 일시",
            "example": "2026-12-03T09:00:00+09:00"
          },
          "cancelDeadline": {
            "type": "string",
            "format": "date-time",
            "description": "취소 기한 = 시작 일시 − 24시간(이 시각까지 취소 가능)",
            "example": "2026-12-02T09:00:00+09:00"
          }
        },
        "required": [
          "appliedCount",
          "cancelDeadline",
          "capacity",
          "courseId",
          "enrollmentDeadline",
          "remainingSeats",
          "startAt",
          "title"
        ]
      }
    }
  }
}
